{
  "name": "dsh-cloudflare-dash",
  "version": "0.4.0",
  "type": "module",
  "description": "Cloudflare Web Analytics dashboard for DeepSeek Harness, built on the official Cloudflare API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/north30-dev/dsh-cloudflare-dash.git"
  },
  "homepage": "https://github.com/north30-dev/dsh-cloudflare-dash#readme",
  "bugs": {
    "url": "https://github.com/north30-dev/dsh-cloudflare-dash/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "cloudflare",
    "web-analytics",
    "dashboard"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "dist",
    "src/host",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
